<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>13</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Bold</Style>
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <!-- základní ASCII -->
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <!-- česká diakritika (á é í ó ú ý č ď ě ň ř š ť ů ž ...) -->
      <CharacterRegion>
        <Start>&#192;</Start>
        <End>&#382;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
